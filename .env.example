# ============================================================
# Application Configuration
# ============================================================

APP_NAME=Agentic SDLC
APP_ENV=development
LOG_LEVEL=INFO


# ============================================================
# LLM Configuration
# ============================================================

# Add your actual API key only in the local .env file.
OPENAI_API_KEY=

# Gemini API key -- the agents (research, PRD writer, design, evaluators)
# run on Gemini via Google's OpenAI-SDK-compatible endpoint
# (ai_agents/gemini_model.py).
GEMINI_API_KEY=


# ============================================================
# Slack Configuration
# ============================================================

# Slack bot token.
SLACK_BOT_TOKEN=

# Slack app-level token (Socket Mode, starts with xapp-).
SLACK_APP_TOKEN=

# Slack signing secret.
SLACK_SIGNING_SECRET=


# ============================================================
# AWS Configuration
# ============================================================

AWS_REGION=ap-south-1


# ============================================================
# RAG / Vector Database
# ============================================================

# Local Qdrant URL.
QDRANT_URL=http://localhost:6333

# Qdrant API key.
# Leave empty when authentication is not enabled.
QDRANT_API_KEY=


# ============================================================
# Jira Configuration
# ============================================================

# Base URL of the Jira instance, e.g. https://your-domain.atlassian.net
JIRA_BASE_URL=

# Email address of the Jira account used for API auth.
JIRA_EMAIL=

# Jira API token for the account above.
JIRA_API_TOKEN=

# Project key that generated issues are created under, e.g. PROJ.
JIRA_PROJECT_KEY=

# Default assignee (Jira Cloud accountId, e.g. "712020:xxxxxxxx-xxxx-xxxx-
# xxxx-xxxxxxxxxxxx") for generated child tickets of each work type. Find a
# user's accountId via Jira's "Manage users" admin page or the
# /rest/api/3/myself endpoint. Leave empty to create tickets unassigned.
JIRA_ASSIGNEE_DESIGN=
JIRA_ASSIGNEE_FRONTEND=
JIRA_ASSIGNEE_BACKEND=
JIRA_ASSIGNEE_INTEGRATION=
JIRA_ASSIGNEE_QA=
JIRA_ASSIGNEE_DEVOPS=


# ============================================================
# Figma Configuration
# ============================================================

# Shared secret the Figma plugin sends as X-Plugin-Token on every request to
# the Figma job service (integrations/figma/). Generate any random string,
# e.g. `openssl rand -hex 32`, and paste the same value into the plugin's
# ui.html token field.
FIGMA_PLUGIN_API_TOKEN=

# Port the Figma job service (FastAPI) listens on.
FIGMA_JOB_SERVICE_PORT=8787